diff --git a/lib/factbase/lazy_taped.rb b/lib/factbase/lazy_taped.rb
index 12eedd3..6355488 100644
--- a/lib/factbase/lazy_taped.rb
+++ b/lib/factbase/lazy_taped.rb
@@ -58,6 +58,17 @@ class Factbase::LazyTaped
     r
   end
 
+  # Resolve the journal's object IDs against the final transaction contents.
+  # An insert-only transaction needs only its staged facts.
+  def lookup(ids)
+    return {} if ids.empty?
+    maps = @staged.to_h { |m| [m.object_id, m] }
+    unless copied? || ids.all? { |oid| maps.key?(oid) }
+      maps.merge!(@origin.to_h { |m| [m.object_id, m] })
+    end
+    maps
+  end
+
   def size
     copied? ? @staged.size : (@origin.size + @staged.size)
   end
diff --git a/test/test_factbase.rb b/test/test_factbase.rb
index abff7a2..1ccc9a1 100644
--- a/test/test_factbase.rb
+++ b/test/test_factbase.rb
@@ -328,6 +328,16 @@ class TestFactbase < Factbase::Test
     assert_equal(1, fb.query('(eq foo 1)').each.to_a.size)
   end
 
+  def test_counts_inserted_facts_once_after_modifying_them_in_txn
+    fb = Factbase.new
+    changes = fb.txn do |txn|
+      10.times { |id| txn.insert.id = id }
+      txn.query('(always)').each { |fact| fact.ready = true }
+    end
+    assert_equal('10i/0d/0a', changes.to_s)
+    assert_equal(10, fb.query('(eq ready true)').count)
+  end
+
   def test_keeps_order_when_modifying_a_fact_in_txn
     fb = Factbase.new
     3.times { |i| fb.insert.then { |f| f.num = i } }
