 # Copyright:: Copyright (c) 2024-2026 Yegor Bugayenko
 # License:: MIT
 class TestIndexedFactbase < Factbase::Test
+  def test_rechecks_comparability_when_a_scoped_map_is_replaced
+    %w[gt gte lt lte].each do |operator|
+      maps = [{ 'x' => [1] }, { 'x' => [2] }]
+      fb = Factbase::IndexedFactbase.new(Factbase.new)
+      fb.query("(#{operator} x 0)", maps).to_a
+      maps[1] = { 'x' => ['incomparable'] }
+      assert_raises(Factbase::Term::Wrapped) { fb.query("(#{operator} x 0)", maps).to_a }
+    end
+  end
+
   def test_queries_after_update
     origin = Factbase.new
     fb = Factbase::IndexedFactbase.new(origin)
