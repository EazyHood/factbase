--- a/lib/factbase/query.rb
+++ b/lib/factbase/query.rb
@@ -94,14 +94,15 @@ class Factbase::Query
   def delete!(fb = @fb)
     @term.forget
     deleted = 0
-    maybe = (@term.predict(@maps, fb, Factbase::Tee.new({}, {})) || @maps).to_a.dup
+    predicted = @term.predict(@maps, fb, Factbase::Tee.new({}, {}))
     before = @maps.to_a.dup
+    remaining = (predicted || before).to_a.tally
     @maps.delete_if do |m|
-      pos = maybe.index { |c| c.eql?(m) }
-      d = !pos.nil? && @term.evaluate(Factbase::Accum.new(Factbase::Fact.new(m), {}, false), before, fb)
-      maybe.delete_at(pos) if d
-      deleted += 1 if d
-      d
+      next false if remaining.fetch(m, 0).zero?
+      next false unless @term.evaluate(Factbase::Accum.new(Factbase::Fact.new(m), {}, false), before, fb)
+      remaining[m] -= 1
+      deleted += 1
+      true
     end
     deleted
   end
