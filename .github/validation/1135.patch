 class TestQuery < Factbase::Test
+  def test_deletes_with_a_term_that_modifies_its_fact
+    name = :modify_during_deletion
+    fb = Factbase.new
+    fb.insert.x = 1
+    Factbase::Term.new(:defn, [name, "fb.query('(eq x 1)').each { |row| row.changed = 1 }; true"])
+      .evaluate(nil, [], fb)
+    begin
+      assert_equal(1, fb.query("(#{name})").delete!)
+      assert_equal(0, fb.size)
+    ensure
+      Factbase::Term.new(:undef, [name]).evaluate(nil, [], fb)
+    end
+  end
